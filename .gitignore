# Android / Gradle
*.iml
.gradle/
local.properties
.idea/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex

# Deliberately NOT a bare `release/`. That pattern matches a directory of that
# name at any depth, which silently swallowed both the release/ notice file and
# the com.fitscroll.app.release source package - present on disk, absent from
# every clone. Gradle's own release output already lives under build/.

# Keystores - never commit signing material
*.jks
*.keystore
keystore.properties

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
