# Copy to android/keystore.properties and fill in. That file is gitignored and
# must never be committed - losing it, or leaking it, both mean losing the
# ability to ship an update that installs over what people already have.
#
# Create the keystore itself with:
#
#   keytool -genkeypair -v \
#     -keystore fitscroll-release.jks \
#     -alias fitscroll \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks somewhere backed up and outside the repository. A 27-year
# validity is deliberate: Play refuses an upload signed with an expired key, and
# there is no way to re-sign an app that is already installed.

storeFile=../fitscroll-release.jks
storePassword=
keyAlias=fitscroll
keyPassword=
