<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FitScroll" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fitscroll_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- The lock screen must cover the blocked app completely and must not
         animate in from the side like a normal activity, or the transition
         reveals a slice of the app underneath. -->
    <style name="Theme.FitScroll.Lock" parent="Theme.FitScroll">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
