<?xml version="1.0" encoding="utf-8"?>
<!--
  Near-opaque rather than fully solid: a hint of the blocked app bleeding
  through makes it read as "this is covering Instagram" instead of "FitScroll
  crashed and took over your phone".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F50B0F14"
        android:centerColor="#F5200D15"
        android:endColor="#F50B0F14"
        android:type="linear" />
</shape>
